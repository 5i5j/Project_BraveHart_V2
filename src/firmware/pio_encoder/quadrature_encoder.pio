.program quadrature_encoder

; The jump table is placed at origin 0. It is indexed by a 4-bit value:
; {old_B, old_A, new_B, new_A}
.origin 0
    jmp update_state    ; 0000: No change
    jmp forwards_entry  ; 0001: Forwards (00 -> 01)
    jmp backwards_entry ; 0010: Backwards (00 -> 10)
    jmp update_state    ; 0011: Error
    jmp backwards_entry ; 0100: Backwards (01 -> 00)
    jmp update_state    ; 0101: No change
    jmp update_state    ; 0110: Error
    jmp forwards_entry  ; 0111: Forwards (01 -> 11)
    jmp forwards_entry  ; 1000: Forwards (10 -> 00)
    jmp update_state    ; 1001: Error
    jmp update_state    ; 1010: No change
    jmp backwards_entry ; 1011: Backwards (10 -> 11)
    jmp update_state    ; 1100: Error
    jmp backwards_entry ; 1101: Backwards (11 -> 01)
    jmp forwards_entry  ; 1110: Forwards (11 -> 10)
    jmp update_state    ; 1111: No change

.wrap_target
update_state:
    mov y, pins         ; Store current pin state in Y
poll_loop:
    mov x, pins         ; Read new pin state into X
    jmp x!=y, process   ; If changed, process it
    jmp poll_loop       ; Else keep polling

process:
    mov isr, null       ; Clear ISR
    in y, 2             ; Shift in old state {old_B, old_A}
    in x, 2             ; Shift in new state {new_B, new_A}
    mov pc, isr         ; Jump to table index (OldAB NewAB)

forwards_entry:
    set x, 0            ; Prepare 0 for 'forwards'
    jmp push_and_update
backwards_entry:
    set x, 1            ; Prepare 1 for 'backwards'
    ; Fall through to shared push logic
push_and_update:
    mov isr, x          ; Push direction to FIFO
    push noblock        ; Use noblock to avoid stalling if FIFO is full
    jmp update_state    ; Restart the process
.wrap